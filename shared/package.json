{
  "name": "@veritas/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Zod schemas and TypeScript types shared by @veritas/frontend and @veritas/backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:all": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.json src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
